{
  "name": "aias-platform",
  "version": "1.1.0",
  "description": "Enterprise-grade AI consultancy platform showcasing custom AI agents, workflow automation, and intelligent business solutions",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "AI Automated Systems",
    "email": "inquiries@aiautomatedsystems.ca",
    "url": "https://aiautomatedsystems.ca"
  },
  "homepage": "https://aiautomatedsystems.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/shardie-github/aias.git"
  },
  "bugs": {
    "url": "https://github.com/shardie-github/aias/issues",
    "email": "support@aiautomatedsystems.ca"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "automation",
    "workflow",
    "saas",
    "multi-tenant",
    "enterprise",
    "typescript",
    "react",
    "nextjs",
    "supabase"
  ],
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.575.0",
    "next": "^15.5.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm exec playwright install --with-deps chromium && playwright test tests/e2e/smoke.spec.ts tests/e2e/landing-smoke.spec.ts tests/e2e/link-crawl.spec.ts tests/e2e/case-studies-attribution.spec.ts --project=chromium",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm validate:links && pnpm check:route-metadata && pnpm validate:seo && pnpm validate:route-manifest && pnpm validate:metadata-vs-manifest && pnpm validate:schema && pnpm validate:jsonld-smoke && pnpm check:static-first && pnpm pricing-language-check && pnpm audit:messaging",
    "vercel-build": "pnpm doctor && pnpm verify",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "next start",
    "prepare": "husky install || true",
    "test": "pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual:landscape-smoke": "playwright test tests/e2e/hero-breakpoints.visual.spec.ts tests/e2e/landscape-critical.visual.spec.ts --project=visual-landscape-mobile",
    "clean": "rm -rf .next out node_modules/.cache coverage playwright-report test-results",
    "ci:install": "pnpm install --frozen-lockfile --prefer-offline",
    "doctor": "pnpm exec tsx scripts/doctor.ts",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "pricing-language-check": "pnpm exec tsx scripts/check-pricing-language.ts",
    "check:links": "pnpm exec tsx scripts/check-internal-links.ts",
    "ci:lighthouse": "pnpm exec lhci autorun --config=./lighthouserc.json",
    "check:route-metadata": "pnpm exec tsx scripts/check-route-metadata.ts",
    "check:static-first": "pnpm exec tsx scripts/check-static-first.ts",
    "audit:messaging": "pnpm exec tsx scripts/audit-messaging.ts",
    "validate:seo": "pnpm exec tsx scripts/validate-seo.ts",
    "validate:links": "pnpm exec tsx scripts/check-internal-links.ts",
    "validate:schema": "pnpm exec tsx scripts/validate-schema.ts",
    "validate:metadata-vs-manifest": "pnpm exec tsx scripts/validate-metadata-vs-manifest.ts",
    "validate:jsonld-smoke": "pnpm exec tsx scripts/validate-jsonld-smoke.ts",
    "validate:route-manifest": "pnpm exec tsx scripts/validate-route-manifest.ts && pnpm exec prettier --check lib/seo/route-manifest.ts",
    "fix:route-manifest": "pnpm exec tsx scripts/fix-route-manifest.ts",
    "test:unit": "pnpm exec vitest run tests/unit/validate-seo-utils.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "axe-playwright": "^1.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.9",
  "pnpm": {
    "overrides": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@types/react": "$@types/react",
      "@types/react-dom": "$@types/react-dom",
      "@babel/core": "^7.28.6",
      "@playwright/test": "^1.58.0",
      "playwright": "^1.58.0",
      "form-data": ">=2.5.4",
      "semver": ">=5.7.2",
      "axios": ">=0.30.2",
      "ioredis": "5.9.2",
      "qs": "^6.14.1",
      "pdfjs-dist": ">=4.2.67",
      "robots-txt-guard": ">=1.0.2",
      "lodash.set": "npm:@types/lodash.set@latest",
      "tar": ">=7.5.7",
      "bl": ">=0.9.5",
      "got": ">=11.8.5",
      "nanoid": ">=3.3.8",
      "lodash": ">=4.17.23",
      "undici": ">=7.18.2",
      "esbuild": ">=0.25.0",
      "ai": ">=5.0.52",
      "tough-cookie": ">=4.1.3",
      "cookie": ">=0.7.0",
      "tmp": ">=0.2.4"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "@types/react": "19",
        "@types/react-dom": "19"
      }
    }
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/your-org"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss,sass}": [
      "prettier --write"
    ]
  }
}
