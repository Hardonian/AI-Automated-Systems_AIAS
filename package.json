{
  "name": "aias-platform",
  "version": "1.1.0",
  "description": "Static-first consultancy site for governed AI systems, workflow automation, and operational architecture",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "AI Automated Systems",
    "email": "inquiries@aiautomatedsystems.ca",
    "url": "https://aiautomatedsystems.ca"
  },
  "homepage": "https://aiautomatedsystems.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hardonian/AI-Automated-Systems_AIAS.git"
  },
  "bugs": {
    "url": "https://github.com/Hardonian/AI-Automated-Systems_AIAS/issues",
    "email": "support@aiautomatedsystems.ca"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "automation",
    "workflow",
    "consultancy",
    "governance",
    "enterprise",
    "typescript",
    "react",
    "nextjs",
    "static-site"
  ],
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "pnpm generate:feeds && pnpm generate:social-assets && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts tests/e2e/landing-smoke.spec.ts tests/e2e/link-crawl.spec.ts tests/e2e/case-studies-attribution.spec.ts tests/e2e/catalog-assets.spec.ts tests/e2e/docs.spec.ts --project=chromium --workers=4",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm lint:markdown && pnpm scan:secrets && pnpm check:security-invariants && pnpm check:release-integrity && pnpm check:catalog-assets && pnpm build && pnpm check:bundle-size && pnpm validate:links && pnpm check:route-metadata && pnpm validate:seo && pnpm validate:route-manifest && pnpm validate:metadata-vs-manifest && pnpm validate:schema && pnpm validate:jsonld-smoke && pnpm validate:schema-org && pnpm audit:twitter-cards && pnpm lint:canonical-urls && pnpm check:static-first && pnpm pricing-language-check && pnpm audit:messaging",
    "vercel-build": "pnpm doctor && pnpm verify",
    "build:analyze": "pnpm build && pnpm check:bundle-size && pnpm exec tsx scripts/write-bundle-report.ts",
    "preview": "pnpm serve:static",
    "serve:static": "node scripts/serve-static.mjs out 3000",
    "prepare": "husky install || true",
    "test": "pnpm test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual:landscape-smoke": "playwright test tests/e2e/critical-surfaces.visual.spec.ts --project=visual-landscape-mobile",
    "clean": "rm -rf .next out node_modules/.cache coverage playwright-report test-results",
    "ci:install": "pnpm install --frozen-lockfile --prefer-offline",
    "doctor": "pnpm exec tsx scripts/doctor.ts",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "pricing-language-check": "pnpm exec tsx scripts/check-pricing-language.ts",
    "check:links": "pnpm exec tsx scripts/check-internal-links.ts",
    "ci:lighthouse": "pnpm exec lhci autorun --config=./lighthouserc.json",
    "check:route-metadata": "pnpm exec tsx scripts/check-route-metadata.ts",
    "check:static-first": "pnpm exec tsx scripts/check-static-first.ts",
    "audit:messaging": "pnpm exec tsx scripts/audit-messaging.ts",
    "validate:seo": "pnpm exec tsx scripts/validate-seo.ts",
    "validate:links": "pnpm exec tsx scripts/check-internal-links.ts",
    "validate:schema": "pnpm exec tsx scripts/validate-schema.ts",
    "validate:metadata-vs-manifest": "pnpm exec tsx scripts/validate-metadata-vs-manifest.ts",
    "validate:jsonld-smoke": "pnpm exec tsx scripts/validate-jsonld-smoke.ts",
    "validate:schema-org": "pnpm exec tsx scripts/validate-schema-org.ts",
    "audit:twitter-cards": "pnpm exec tsx scripts/audit-twitter-cards.ts",
    "lint:canonical-urls": "pnpm exec tsx scripts/lint-canonical-urls.ts",
    "validate:route-manifest": "pnpm exec tsx scripts/validate-route-manifest.ts && pnpm exec prettier --check lib/seo/route-manifest.ts",
    "fix:route-manifest": "pnpm exec tsx scripts/fix-route-manifest.ts",
    "test:unit": "pnpm exec vitest run",
    "lint:critical": "pnpm lint",
    "test:critical": "pnpm typecheck && pnpm test:unit",
    "deploy:guard": "pnpm verify",
    "test:visual": "playwright test --project=visual-desktop --project=visual-tablet --project=visual-mobile --project=visual-landscape-mobile --workers=4",
    "test:visual:desktop": "playwright test --project=visual-desktop",
    "test:visual:tablet": "playwright test --project=visual-tablet",
    "test:visual:mobile": "playwright test --project=visual-mobile",
    "test:audit": "playwright test tests/e2e/ui-consistency-audit.spec.ts --project=chromium --workers=1",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium --workers=1",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-tablet --project=visual-mobile --project=visual-landscape-mobile --workers=4 --update-snapshots",
    "lint:markdown": "pnpm exec tsx scripts/lint-markdown.ts",
    "scan:secrets": "pnpm exec tsx scripts/scan-secrets.ts",
    "scan:secrets:staged": "pnpm exec tsx scripts/scan-secrets.ts --staged",
    "check:security-invariants": "pnpm exec tsx scripts/check-security-invariants.ts",
    "check:release-integrity": "pnpm exec tsx scripts/check-release-integrity.ts",
    "images:avif": "node scripts/convert-images-to-avif.mjs",
    "generate:feeds": "pnpm exec tsx scripts/generate-feeds.ts",
    "generate:social-assets": "node scripts/generate-social-assets.mjs",
    "collect:static-metrics": "pnpm exec tsx scripts/collect-static-metrics.ts",
    "indexnow": "pnpm exec tsx scripts/submit-indexnow.ts",
    "check:bundle-size": "pnpm exec tsx scripts/check-bundle-size.ts",
    "check:catalog-assets": "pnpm exec tsx scripts/check-catalog-assets.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.5",
    "axe-playwright": "^1.2.3",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^8.0.3",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.5.2",
    "next-router-mock": "^1.0.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "undici": "^8.10.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "resolutions": {
    "postcss": ">=8.5.15"
  },
  "overrides": {
    "postcss": ">=8.5.15"
  },
  "packageManager": "pnpm@8.15.9",
  "publishConfig": {
    "access": "restricted"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss,sass}": [
      "prettier --write"
    ]
  }
}
