# AIAS public build-time configuration
# Copy to .env.local for local development. Never place secrets in NEXT_PUBLIC_*.

NEXT_PUBLIC_SITE_URL=https://aiautomatedsystems.ca
NEXT_PUBLIC_APP_ENV=production

# Optional search-engine ownership tokens
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=

# Privacy-preserving analytics already wired into the client runtime
NEXT_PUBLIC_ANALYTICS_PROVIDER=vercel

# Static-first intake delivery. Keep `none` until a receiving endpoint is
# verified for schema validation, abuse controls, retention, and monitoring.
# Supported providers: none, formspree, custom
NEXT_PUBLIC_INTAKE_PROVIDER=none
NEXT_PUBLIC_INTAKE_WEBHOOK_URL=

# Optional static feature surfaces
AIAS_ENABLE_OPERATOR=false
