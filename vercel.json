{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run verify",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "ignoreCommand": "git rev-parse --verify HEAD^ >/dev/null 2>&1 && git diff --quiet HEAD^ HEAD . || exit 1",
  "regions": ["iad1"]
}
