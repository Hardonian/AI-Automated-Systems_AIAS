{
  "agentMode": "static-site-quality",
  "autoRun": true,
  "repoType": "nextjs-static-site",
  "detectedStack": {
    "frontend": "Next.js 16",
    "backend": null,
    "deployment": "Vercel static export",
    "mobile": null,
    "library": false
  },
  "operatingModes": {
    "webapp": {
      "enabled": true,
      "vercelOptimization": true,
      "nextjsAudit": true
    },
    "backend": {
      "enabled": false
    }
  },
  "modules": {
    "quality": {
      "enabled": true,
      "checks": [
        "pnpm verify",
        "pnpm test:e2e",
        "pnpm test:a11y",
        "pnpm test:visual"
      ]
    },
    "planning": {
      "enabled": true,
      "todoExtraction": true,
      "issueCreation": false,
      "sprintPlanning": false
    },
    "documentation": {
      "enabled": true,
      "intentLogging": false
    }
  },
  "artifacts": {
    "quality": {
      "closureRecord": "CHANGELOG.md"
    }
  },
  "integrations": {
    "vercel": {
      "enabled": true
    }
  },
  "safety": {
    "neverExposeSecrets": true,
    "preferPR": true,
    "staticFirst": true,
    "noBackend": true
  }
}
